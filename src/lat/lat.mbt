//
// Euclidean lattices: LLL reduction and its certificates.
//
//   Definition.  A basis b_1,…,b_n of a lattice L ⊂ R^m is LLL-reduced with
//   parameter δ ∈ (1/4, 1] when, writing b_i^* for the Gram–Schmidt vectors
//   and b_i = b_i^* + Σ_{j<i} μ_{i,j} b_j^*,
//
//       (size)   |μ_{i,j}| ≤ 1/2                     for all j < i
//       (Lovász) δ · |b_{i-1}^*|² ≤ |b_i^*|² + μ_{i,i-1}² |b_{i-1}^*|²
//
//   Theorem (LLL).  `lll_reduce` terminates and returns a δ-LLL-reduced basis
//   of the *same* lattice, and its first vector satisfies
//       |b_1| ≤ 2^{(n-1)/2} · λ_1(L).
//
//   "同構即相同" here: two integer matrices generate the same sublattice of
//   Z^m iff their Hermite normal forms are *equal* (see `@nf`), so lattice
//   equality — an isomorphism of the underlying Z-modules — is decided by
//   comparing normal forms.  `same_lattice` implements exactly that, and the
//   tests use it to certify that LLL did not change the lattice.

///|
/// Squared norm of an integer vector.
pub fn norm2(v : Array[Int32]) -> Double {
  let mut s = 0.0
  for x in v {
    s = s + x.to_double() * x.to_double()
  }
  s
}


///|
/// Gram–Schmidt data up to index `k` (inclusive).
fn gram_schmidt(
  basis : Array[Array[Int32]],
  k : Int32,
) -> (Array[Array[Double]], Array[Double]) {
  let n = k + 1
  let mu = Array::make(n, Array::make(0, 0.0))
  let bnorm = Array::make(n, 0.0)
  for i = 0; i < n; i = i + 1 {
    mu[i] = Array::make(n, 0.0)
  }
  // incremental Gram-Schmidt using the classical formula
  let bs : Array[Array[Double]] = Array::make(0, Array::make(0, 0.0))
  for i = 0; i < n; i = i + 1 {
    let v = Array::make(basis[i].length(), 0.0)
    for j = 0; j < basis[i].length(); j = j + 1 {
      v[j] = basis[i][j].to_double()
    }
    for j = 0; j < i; j = j + 1 {
      let mut num = dot_d(basis_i(basis, i), bs[j])
      let mut den = dot_d_on(bs[j], bs[j])
      if den == 0.0 {
        den = 1.0
        num = 0.0
      }
      mu[i][j] = num / den
      for t = 0; t < v.length(); t = t + 1 {
        v[t] = v[t] - mu[i][j] * bs[j][t]
      }
    }
    bs.push(v)
    bnorm[i] = dot_d_on(bs[i], bs[i])
  }
  (mu, bnorm)
}

///|
fn basis_i(basis : Array[Array[Int32]], i : Int32) -> Array[Double] {
  let v = Array::make(basis[i].length(), 0.0)
  for j = 0; j < basis[i].length(); j = j + 1 {
    v[j] = basis[i][j].to_double()
  }
  v
}

///|
fn dot_d(a : Array[Double], b : Array[Double]) -> Double {
  let mut s = 0.0
  for i = 0; i < a.length(); i = i + 1 {
    s = s + a[i] * b[i]
  }
  s
}

///|
fn dot_d_on(a : Array[Double], b : Array[Double]) -> Double {
  dot_d(a, b)
}

///|
/// LLL reduction.  `basis` is a list of integer row vectors; `delta` is the
/// Lovász parameter (typically 0.75 or 0.99).
pub fn lll_reduce(
  basis0 : Array[Array[Int32]],
  delta : Double,
) -> Array[Array[Int32]] {
  let n = basis0.length()
  if n == 0 {
    return []
  }
  let basis = Array::make(n, Array::make(0, 0))
  for i = 0; i < n; i = i + 1 {
    basis[i] = basis0[i].copy()
  }
  if n == 1 {
    return basis
  }
  let mut k = 1
  let mut steps = 0
  while k < n {
    steps = steps + 1
    if steps > 100000 {
      abort("lll: divergence")
    }
    // size reduction
    let (mu, _b) = gram_schmidt(basis, k)
    let mut j = k - 1
    while j >= 0 {
      let q = round_half(mu[k][j])
      if q != 0 {
        for t = 0; t < basis[k].length(); t = t + 1 {
          basis[k][t] = basis[k][t] - q * basis[j][t]
        }
        let (mu2, _b2) = gram_schmidt(basis, k)
        let _ = mu2
      }
      j = j - 1
    }
    let (mu3, bnorm) = gram_schmidt(basis, k)
    let lhs = bnorm[k]
    let rhs = (delta - mu3[k][k - 1] * mu3[k][k - 1]) * bnorm[k - 1]
    if lhs >= rhs {
      k = k + 1
    } else {
      let t = basis[k]
      basis[k] = basis[k - 1]
      basis[k - 1] = t
      k = if k > 1 { k - 1 } else { 1 }
    }
  }
  basis
}

///|
/// Nearest integer.
pub fn round_half(x : Double) -> Int32 {
  if x >= 0.0 {
    (x + 0.5).to_int()
  } else {
    0 - (0.0 - x + 0.5).to_int()
  }
}


///|
/// Check the two LLL conditions (size reduction and Lovász) to within
/// `eps`.
pub fn is_lll_reduced(
  basis : Array[Array[Int32]],
  delta : Double,
  eps : Double,
) -> Bool {
  let n = basis.length()
  if n <= 1 {
    return true
  }
  let (mu, bnorm) = gram_schmidt(basis, n - 1)
  for i = 1; i < n; i = i + 1 {
    for j = 0; j < i; j = j + 1 {
      if mu[i][j] > 0.5 + eps || mu[i][j] < 0.0 - 0.5 - eps {
        return false
      }
    }
    let lhs = bnorm[i]
    let rhs = (delta - mu[i][i - 1] * mu[i][i - 1]) * bnorm[i - 1]
    if lhs < rhs - eps {
      return false
    }
  }
  true
}

///|
/// The lattice generated by the rows of `a` (as a sublattice of Z^m) is a
/// Z-module; two matrices generate the same lattice iff their Hermite normal
/// forms agree.  This turns an *isomorphism* of lattices into *equality* of
/// normal forms (同構即相同).
pub fn same_lattice(a : Array[Array[Int32]], b : Array[Array[Int32]]) -> Bool {
  @nf.hermite_normal_form(a) == @nf.hermite_normal_form(b)
}

///|
/// Gram matrix of the rows.
pub fn gram(a : Array[Array[Int32]]) -> Array[Array[Int32]] {
  let n = a.length()
  let out = @nf.mat_make(n, n)
  for i = 0; i < n; i = i + 1 {
    for j = 0; j < n; j = j + 1 {
      out[i][j] = dot_int(a[i], a[j])
    }
  }
  out
}

///|
fn dot_int(a : Array[Int32], b : Array[Int32]) -> Int32 {
  let mut s = 0
  for i = 0; i < a.length(); i = i + 1 {
    s = s + a[i] * b[i]
  }
  s
}

///|
/// Brute-force shortest vector: enumerate coefficient vectors in
/// `[-bound, bound]^n` and return the minimal squared norm.  Exponential —
/// only for certification on small inputs.
pub fn shortest_norm2_brute(
  basis : Array[Array[Int32]],
  bound : Int32,
) -> Double {
  let n = basis.length()
  if n == 0 {
    return 0.0
  }
  let m = basis[0].length()
  let best : Ref[Double] = { val: 1.0e300, }
  let coeffs = Array::make(n, 0)
  enumerate_combinations(basis, coeffs, 0, n, m, bound, best)
  best.val
}

///|
fn enumerate_combinations(
  basis : Array[Array[Int32]],
  coeffs : Array[Int32],
  idx : Int32,
  n : Int32,
  m : Int32,
  bound : Int32,
  best : Ref[Double],
) -> Unit {
  if idx == n {
    // skip the zero vector
    let mut nz = false
    for c in coeffs {
      if c != 0 {
        nz = true
      }
    }
    if !nz {
      return
    }
    let v = Array::make(m, 0)
    for i = 0; i < n; i = i + 1 {
      if coeffs[i] != 0 {
        for j = 0; j < m; j = j + 1 {
          v[j] = v[j] + coeffs[i] * basis[i][j]
        }
      }
    }
    let nrm = norm2(v)
    if nrm < best.val {
      best.val = nrm
    }
    return
  }
  let mut c = 0 - bound
  while c <= bound {
    coeffs[idx] = c
    enumerate_combinations(basis, coeffs, idx + 1, n, m, bound, best)
    c = c + 1
  }
}

///|
/// Hadamard's bound: |det| ≤ Π |b_i|.
pub fn hadamard_bound(basis : Array[Array[Int32]]) -> Double {
  let mut p = 1.0
  for v in basis {
    p = p * norm2(v).sqrt()
  }
  p
}

///|
/// The determinant of the lattice (for a full rank square basis).
pub fn lattice_det(basis : Array[Array[Int32]]) -> Int32 {
  @nf.abs_int_export(@nf.mat_det(basis))
}

///|
/// Minkowski-style comparison used in the tests: the first LLL vector is
/// within 2^{(n-1)/2} of the shortest vector.
pub fn lll_approximation_factor(n : Int32) -> Double {
  let mut f = 1.0
  let mut i = 1
  while i < n {
    f = f * 2.0.sqrt()
    i = i + 1
  }
  f
}
