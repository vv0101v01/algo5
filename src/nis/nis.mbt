/// 尼雲維奇拓撲 (THE NISNEVICH TOPOLOGY) — the Grothendieck topology that
/// sits strictly between Zariski and étale, machine-checked on the small
/// Nisnevich site of finite étale F_p-algebras.
///
/// Definition (general)
/// -------------------
/// A family {u_α : X_α → X} of *étale* morphisms is a **Nisnevich cover** iff
/// it is *completely decomposed*: for every point x ∈ X there are α and a
/// point y ∈ X_α with u_α(y) = x such that the induced extension of residue
/// fields κ(x) → κ(y) is an isomorphism.  (Equivalently: the family is an
/// étale cover and, for every x, some member has a rational point in the
/// fibre over x.)  The resulting Grothendieck topology Nis satisfies
///         Zariski  ⊊  Nisnevich  ⊊  étale ,
/// it is generated by the *distinguished squares* (excision)
///         X∖Z → X
///          ↑     ↑
///       U∖E  →  U        (E = u^{−1}(Z), u étale, E → Z an isomorphism),
/// and its topos is the homotopy-theoretic "unstable A¹-homotopy" site
/// (Nisnevich, 1989; Morel–Voevodsky).
///
/// Model checked here
/// ------------------
/// The small Nisnevich site restricted to *finite étale* F_p-algebras: an
/// object is A = Π_i K_i with K_i = F_{p^{d_i}} (a finite product of finite
/// fields, equivalently a finite étale F_p-algebra), a point of Spec A is a
/// factor K_i, and its residue field is K_i itself.  A morphism
/// Spec B → Spec A (i.e. an F_p-algebra map A → B) is given by, for each
/// factor L_j of B, the factor K_{σ(j)} of A it lies over together with an
/// F_p-embedding K_{σ(j)} ↪ L_j — such an embedding exists iff
/// d_{σ(j)} ∣ deg L_j, and then
///
///     residue degree at the point j  =  deg L_j / d_{σ(j)} ,
///     number of embeddings K_{σ(j)} ↪ L_j  =  d_{σ(j)}  (Frobenius twists).
///
/// So all the data of the site is carried by the *degrees*, and the tensor
/// product of finite fields
///
///     F_{p^a} ⊗_{F_{p^c}} F_{p^b} ≅ ( F_{p^{lcm(a,b)}} )^{gcd(a,b)/c}
///
/// makes fibre products computable.
///
/// Theorems implemented here
/// -------------------------
/// T1 (The three topologies).  For a family {A → B_α}:
///     étale cover       ⟺ every point of A is hit by some point of some B_α;
///     Nisnevich cover   ⟺ in addition every point of A is hit by a point of
///                         *residue degree 1* (κ(x) ≅ κ(y));
///     Zariski cover     ⟺ each member is an open immersion (injective on
///                         points, all residue degrees 1) and they cover.
///     Zariski ⟹ Nisnevich ⟹ étale, both strict.
/// T2 (Base change).  If {B_α → A} is a Nisnevich cover and C → A is any
/// morphism, then {B_α ×_A C → C} is a Nisnevich cover.
/// T3 (Composition).  If {B_α → A} is a Nisnevich cover and, for each α,
/// {C_{αβ} → B_α} is a Nisnevich cover, then the composite family
/// {C_{αβ} → A} is a Nisnevich cover.
/// T4 (Sections).  Every Nisnevich cover of A admits a section A → ⊔_α B_α
/// (choose, for each point of A, a point of residue degree 1: the residue
/// field extension is then an isomorphism, giving the required map).  This
/// fails for étale covers that are not Nisnevich — the precise sense in which
/// the Nisnevich topology is "completely decomposed".
/// T5 (Descent).  The presheaf F(A) = Map(π₀(Spec A), S) is a sheaf for the
/// Nisnevich topology: a family of elements s_α ∈ F(B_α) descends iff it is
/// compatible on the fibre products, and the descent is unique precisely
/// because a Nisnevich cover is surjective on points.

///|
/// A finite étale F_p-algebra A = Π_i F_{p^{d_i}}, by the degrees d_i.
pub type Et = Array[Int32]

///|
/// A morphism Spec B → Spec A: for each factor j of B, the index σ(j) of the
/// factor of A it lies over.
pub(all) struct EtMor {
  sigma : Array[Int32]
}

///|
pub fn etmor_new(sigma : Array[Int32]) -> EtMor {
  { sigma, }
}

///|
pub fn etmor_get(m : EtMor, j : Int32) -> Int32 {
  m.sigma[j]
}

///|
/// gcd(|a|,|b|).  Delegates to `@tl.igcd`: one implementation, shared.
pub fn gcd_pos(a : Int32, b : Int32) -> Int32 {
  @tl.igcd(a, b)
}

///|
pub fn lcm_pos(a : Int32, b : Int32) -> Int32 {
  a / gcd_pos(a, b) * b
}

///|
pub fn divides(a : Int32, b : Int32) -> Bool {
  a != 0 && b % a == 0
}

///|
/// Is `m` a well-defined morphism Spec B → Spec A?  (Each factor of B must
/// lie over a factor of A whose degree divides its own, so that an
/// F_p-embedding exists.)
pub fn is_mor(a : Et, b : Et, m : EtMor) -> Bool {
  if m.sigma.length() != b.length() {
    return false
  }
  for j = 0; j < b.length(); j = j + 1 {
    let i = m.sigma[j]
    if i < 0 || i >= a.length() {
      return false
    }
    if !(divides(a[i], b[j])) {
      return false
    }
  }
  true
}

///|
/// The residue degree of the point j of B over its image in A.
pub fn res_degree(a : Et, b : Et, m : EtMor, j : Int32) -> Int32 {
  b[j] / a[m.sigma[j]]
}

///|
/// The number of F_p-embeddings A_{σ(j)} ↪ B_j (the Frobenius twists).
pub fn num_embeddings(a : Et, _b : Et, m : EtMor, j : Int32) -> Int32 {
  a[m.sigma[j]]
}

///|
/// The dimension of B as an F_p-vector space.
pub fn et_dim(a : Et) -> Int32 {
  let mut acc = 0
  for d in a {
    acc = acc + d
  }
  acc
}


///|
/// Is the morphism surjective on points (the underlying map of a cover)?
pub fn is_surjective(a : Et, b : Et, m : EtMor) -> Bool {
  for i = 0; i < a.length(); i = i + 1 {
    let mut hit = false
    for j = 0; j < b.length(); j = j + 1 {
      if m.sigma[j] == i {
        hit = true
        break
      }
    }
    if !hit {
      return false
    }
  }
  true
}

///|
/// Is the point i of A split off by the morphism (some point over it has
/// residue degree 1)?
pub fn splits_point(a : Et, b : Et, m : EtMor, i : Int32) -> Bool {
  for j = 0; j < b.length(); j = j + 1 {
    if m.sigma[j] == i && res_degree(a, b, m, j) == 1 {
      return true
    }
  }
  false
}

///|
/// T1: an étale cover = surjective on points.
pub fn is_etale_cover(a : Et, b : Et, m : EtMor) -> Bool {
  is_mor(a, b, m) && is_surjective(a, b, m)
}

///|
/// T1: a Nisnevich cover = étale + completely decomposed (every point splits).
pub fn is_nisnevich_cover(a : Et, b : Et, m : EtMor) -> Bool {
  if !is_etale_cover(a, b, m) {
    return false
  }
  for i = 0; i < a.length(); i = i + 1 {
    if !splits_point(a, b, m, i) {
      return false
    }
  }
  true
}

///|
/// T1: a Zariski cover = injective on points with all residue degrees 1
/// (an open immersion), and covering.
pub fn is_zariski_cover(a : Et, b : Et, m : EtMor) -> Bool {
  if !is_mor(a, b, m) {
    return false
  }
  // injective on points
  for j1 = 0; j1 < b.length(); j1 = j1 + 1 {
    for j2 = j1 + 1; j2 < b.length(); j2 = j2 + 1 {
      if m.sigma[j1] == m.sigma[j2] {
        return false
      }
    }
  }
  for j = 0; j < b.length(); j = j + 1 {
    if res_degree(a, b, m, j) != 1 {
      return false
    }
  }
  is_surjective(a, b, m)
}

// ---------------------------------------------------------------------------
// T2/T3: fibre products, base change, composition.
// ---------------------------------------------------------------------------

///|
/// The fibre product B ×_A C, using
///   F_{p^a} ⊗_{F_{p^c}} F_{p^b} ≅ (F_{p^{lcm(a,b)}})^{gcd(a,b)/c} :
/// over a point i of A, each pair (j, l) with σ(j) = τ(l) = i contributes
/// gcd(deg B_j, deg C_l)/deg A_i points of degree lcm(deg B_j, deg C_l).
/// Returns (the algebra, the projection to B, the projection to C).
pub fn fiber_product(
  a : Et,
  b : Et,
  c : Et,
  sigma : EtMor,
  tau : EtMor,
) -> (Et, EtMor, EtMor) {
  let degs : Et = []
  let to_b : Array[Int32] = []
  let to_c : Array[Int32] = []
  for j = 0; j < b.length(); j = j + 1 {
    for l = 0; l < c.length(); l = l + 1 {
      if sigma.sigma[j] != tau.sigma[l] {
        continue
      }
      let i = sigma.sigma[j]
      let d = lcm_pos(b[j], c[l])
      let mult = gcd_pos(b[j], c[l]) / a[i]
      let mut t = 0
      while t < mult {
        degs.push(d)
        to_b.push(j)
        to_c.push(l)
        t = t + 1
      }
    }
  }
  (degs, etmor_new(to_b), etmor_new(to_c))
}

///|
/// T2: the base change of a morphism along C → A.
pub fn base_change(
  a : Et,
  b : Et,
  c : Et,
  sigma : EtMor,
  tau : EtMor,
) -> (Et, EtMor) {
  let (bc, _pb, pc) = fiber_product(a, b, c, sigma, tau)
  (bc, pc)
}

///|
/// Composition of morphisms Spec C → Spec B → Spec A.
pub fn compose_mor(_b : Et, c : Et, sigma : EtMor, tau : EtMor) -> EtMor {
  let out : Array[Int32] = []
  for l = 0; l < c.length(); l = l + 1 {
    out.push(sigma.sigma[tau.sigma[l]])
  }
  etmor_new(out)
}

///|
/// The identity morphism.
pub fn id_mor(a : Et) -> EtMor {
  let out : Array[Int32] = []
  for i = 0; i < a.length(); i = i + 1 {
    out.push(i)
  }
  etmor_new(out)
}

// ---------------------------------------------------------------------------
// T4: sections of Nisnevich covers.
// ---------------------------------------------------------------------------

///|
/// T4: a section of a Nisnevich cover: for each point i of A, the index of a
/// point of B over it with residue degree 1.  Such a point gives an
/// isomorphism of residue fields, hence an F_p-algebra map B → A which is a
/// right inverse of A → B (the cover is completely decomposed).
pub fn nisnevich_section(a : Et, b : Et, m : EtMor) -> Array[Int32] {
  if !is_nisnevich_cover(a, b, m) {
    abort("nisnevich_section: not a Nisnevich cover")
  }
  let out : Array[Int32] = []
  for i = 0; i < a.length(); i = i + 1 {
    let mut found = 0 - 1
    for j = 0; j < b.length(); j = j + 1 {
      if m.sigma[j] == i && res_degree(a, b, m, j) == 1 {
        found = j
        break
      }
    }
    out.push(found)
  }
  out
}

///|
/// Verify a purported section: every entry must be a point of residue degree
/// 1 over the corresponding point of A.
pub fn is_section(a : Et, b : Et, m : EtMor, s : Array[Int32]) -> Bool {
  if s.length() != a.length() {
    return false
  }
  for i = 0; i < a.length(); i = i + 1 {
    let j = s[i]
    if j < 0 || j >= b.length() {
      return false
    }
    if m.sigma[j] != i || res_degree(a, b, m, j) != 1 {
      return false
    }
  }
  true
}

///|
/// Does the cover admit a section at all (used to show étale covers that are
/// not Nisnevich need not have one)?
pub fn has_section(a : Et, b : Et, m : EtMor) -> Bool {
  for i = 0; i < a.length(); i = i + 1 {
    if !splits_point(a, b, m, i) {
      return false
    }
  }
  true
}

// ---------------------------------------------------------------------------
// T5: descent for the presheaf of locally constant functions.
// ---------------------------------------------------------------------------

///|
/// An element of F(A) = Map(π₀(Spec A), S): the values on the factors.
pub type Sect = Array[Int32]

///|
/// The pullback of a section along Spec B → Spec A.
pub fn pullback(_a : Et, b : Et, m : EtMor, s : Sect) -> Sect {
  let out : Sect = []
  for j = 0; j < b.length(); j = j + 1 {
    out.push(s[m.sigma[j]])
  }
  out
}

///|
pub fn sect_eq(a : Sect, b : Sect) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i = 0; i < a.length(); i = i + 1 {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

///|
/// T5: the sheaf axiom for F on the cover {B → A}: the map
/// F(A) → F(B) ⇉ F(B ×_A B) is an equalizer.  Checked by verifying that
/// (i) pullbacks of sections agree on the fibre product (soundness), and
/// (ii) every section of B whose two pullbacks to B ×_A B agree comes from a
/// unique section of A (descent), which holds exactly because a Nisnevich
/// cover is surjective on points.
pub fn descends(a : Et, b : Et, m : EtMor, s : Sect) -> Bool {
  let (bc, pb, pc) = fiber_product(a, b, b, m, m)
  let l = pullback(b, bc, pb, s)
  let r = pullback(b, bc, pc, s)
  sect_eq(l, r)
}

///|
/// The descended section of A (unique when `descends` holds and the cover is
/// surjective), or nothing when the data is not compatible.
pub fn descend_section(a : Et, b : Et, m : EtMor, s : Sect) -> Sect {
  let out : Sect = []
  for i = 0; i < a.length(); i = i + 1 {
    let mut val = 0 - 1
    for j = 0; j < b.length(); j = j + 1 {
      if m.sigma[j] == i {
        val = s[j]
        break
      }
    }
    out.push(val)
  }
  out
}

///|
/// All F_p-algebra maps A → B (equivalently Spec B → Spec A) as morphisms:
/// enumerate the choices of image points.
pub fn all_morphisms(a : Et, b : Et) -> Array[EtMor] {
  let out : Array[EtMor] = []
  let cur : Array[Int32] = Array::make(b.length(), 0)
  enumerate_morphisms(a, b, 0, cur, out)
  out
}

///|
fn enumerate_morphisms(
  a : Et,
  b : Et,
  j : Int32,
  cur : Array[Int32],
  out : Array[EtMor],
) -> Unit {
  if j == b.length() {
    out.push(etmor_new(cur.copy()))
    return
  }
  for i = 0; i < a.length(); i = i + 1 {
    if divides(a[i], b[j]) {
      cur[j] = i
      enumerate_morphisms(a, b, j + 1, cur, out)
    }
  }
}

///|
/// The number of F_p-algebra maps A → B: Π_j (Σ_{i : d_i ∣ e_j} d_i).
pub fn count_maps(a : Et, b : Et) -> Int32 {
  let mut acc = 1
  for j = 0; j < b.length(); j = j + 1 {
    let mut s = 0
    for i = 0; i < a.length(); i = i + 1 {
      if divides(a[i], b[j]) {
        s = s + a[i]
      }
    }
    acc = acc * s
  }
  acc
}
