///|
/// gcd / extended gcd
test "ext gcd" {
  let (g, s, t) = @nf.ext_gcd(240, 46)
  assert_eq(g, 2)
  assert_eq(s * 240 + t * 46, 2)
  let (g2, _, _) = @nf.ext_gcd(-12, 18)
  assert_eq(g2, 6)
}

///|
/// Smith normal form: U·A·V = D, U and V unimodular, d_1 | d_2 | …
fn snf_certificate(a : Array[Array[Int32]]) -> Bool {
  let s = @nf.smith_normal_form(a)
  let d = @nf.snf_diag(s)
  // divisibility chain
  let mut i = 1
  while i < d.length() {
    if d[i] != 0 && d[i - 1] != 0 && d[i] % d[i - 1] != 0 {
      return false
    }
    if d[i - 1] != 0 && d[i] != 0 && d[i - 1] > d[i] {
      return false
    }
    i = i + 1
  }
  // U, V unimodular
  if @nf.abs_int_export(@nf.mat_det(@nf.snf_u(s))) != 1 {
    return false
  }
  if @nf.abs_int_export(@nf.mat_det(@nf.snf_v(s))) != 1 {
    return false
  }
  // U A V equals the diagonal matrix
  let m = a.length()
  let n = a[0].length()
  let uav = @nf.mat_mul(@nf.mat_mul(@nf.snf_u(s), a), @nf.snf_v(s))
  for i = 0; i < m; i = i + 1 {
    for j = 0; j < n; j = j + 1 {
      let want = if i == j && i < d.length() { d[i] } else { 0 }
      if uav[i][j] != want {
        return false
      }
    }
  }
  true
}

///|

///|
test "smith normal form certificates" {
  assert_true(snf_certificate([[2, 0], [0, 3]]))
  assert_eq(@nf.invariant_factors([[2, 0], [0, 3]]), [1, 6])
  assert_true(snf_certificate([[1, 2, 3], [4, 5, 6], [7, 8, 9]]))
  assert_true(snf_certificate([[0, 0], [0, 0]]))
  assert_true(snf_certificate([[6, 10], [10, 15]]))
  assert_true(snf_certificate([[3, 6, 9], [12, 15, 18]]))
  // a rank-one matrix has one invariant factor equal to the gcd of entries
  assert_eq(@nf.invariant_factors([[6, 10, 14]]), [2])
}

///|
/// 同構即相同 for finitely generated abelian groups:
/// coker(A) ≅ coker(B) iff the Smith normal forms coincide.
test "abelian group isomorphism = equality of normal forms" {
  // Z/2 ⊕ Z/3 ≅ Z/6
  assert_eq(@nf.invariant_factors([[2, 0], [0, 3]]), [1, 6])
  assert_true(@nf.abelian_iso([[2, 0], [0, 3]], [[6, 0], [0, 1]]))
  // Z/4 ⊕ Z/2  ≇  Z/8
  assert_false(@nf.abelian_iso([[4, 0], [0, 2]], [[8, 0], [0, 1]]))
  // Z/12 ≅ Z/4 ⊕ Z/3  (coprime)
  assert_true(@nf.abelian_iso([[12]], [[4, 0], [0, 3]]))
  // elementary divisors of Z/12 ⊕ Z/6
  assert_eq(@nf.elementary_divisors([[12, 0], [0, 6]]), [
    (2, 1),
    (3, 1),
    (2, 2),
    (3, 1),
  ])
  // free rank
  assert_eq(@nf.coker_rank([[0, 0], [0, 0]]), 2)
  assert_eq(@nf.coker_rank([[2, 0], [0, 3]]), 0)
}

///|
/// Hermite normal form is a complete invariant of sublattices of Z^n.
test "hermite normal form" {
  // two bases of the same sublattice of Z^2 have the same HNF
  let a = [[2, 0], [0, 2]]
  let b = [[2, 0], [2, 2]]
  assert_eq(@nf.hermite_normal_form(a), @nf.hermite_normal_form(b))
  assert_eq(
    @nf.hermite_normal_form([[3, 1], [1, 1]]),
    @nf.hermite_normal_form([[1, 1], [3, 1]]),
  )
}

///|
/// rank over Q and over F_p
test "ranks" {
  assert_eq(@nf.rank_q([[1, 2], [2, 4]]), 1)
  assert_eq(@nf.rank_q([[1, 2], [3, 4]]), 2)
  assert_eq(@nf.rank_mod_p([[1, 2], [2, 4]], 2), 1)
  assert_eq(@nf.rank_mod_p([[1, 2], [3, 4]], 2), 1) // [[1,0],[1,0]] over F_2
  assert_eq(@nf.rank_mod_p([[1, 2], [3, 4]], 5), 2)
}

// ---------------------------------------------------------------------------
// Groebner bases over F_p
// ---------------------------------------------------------------------------

///|
pub fn grlex() -> @nf.Cmp {
  @nf.cmp_grlex
}

///|
/// Build a polynomial from (coefficient, exponent-vector) pairs.
pub fn poly_of(ts : Array[(Int32, Array[Int32])], p : Int32) -> @nf.Poly {
  let acc : Array[@nf.Term] = Array::make(0, { c: 0, e: Array::make(0, 0), })
  for (c, e) in ts {
    acc.push({ c, e, })
  }
  @nf.poly_normalize(acc, p, grlex())
}

///|
test "groebner: buchberger criterion and normal forms" {
  let p = 5
  let cmp = grlex()
  // I = (x^2 - y, x*y - 1) in F_5[x,y]
  let f1 = poly_of([(1, [2, 0]), (0 - 1, [0, 1])], p)
  let f2 = poly_of([(1, [1, 1]), (0 - 1, [0, 0])], p)
  let g = @nf.buchberger([f1, f2], p, cmp)
  // Buchberger's criterion
  assert_true(@nf.is_groebner(g, p, cmp))
  // every generator is in the ideal generated by the basis
  assert_true(@nf.in_ideal(f1, g, p, cmp))
  assert_true(@nf.in_ideal(f2, g, p, cmp))
  // the monomial ideal generated by x^2, y^3 : dim F_p[x,y]/I = 6
  let h1 = poly_of([(1, [2, 0])], p)
  let h2 = poly_of([(1, [0, 3])], p)
  let gh = @nf.buchberger([h1, h2], p, cmp)
  assert_eq(@nf.quotient_dim(gh, 2, 6), 6)
  assert_eq(@nf.standard_monomials(gh, 2, 6).length(), 6)
}

///|
/// 同構即相同 in the quotient ring: f - g ∈ I iff NF(f) = NF(g).
/// Verified against a brute-force membership test: f ∈ I iff f vanishes on
/// every common zero of I (over F_p and its small extensions, here F_p^2
/// with p small).
test "normal form decides equality modulo I" {
  let p = 5
  let cmp = grlex()
  let f1 = poly_of([(1, [2, 0]), (0 - 1, [0, 1])], p)
  let f2 = poly_of([(1, [1, 1]), (0 - 1, [0, 0])], p)
  let g = @nf.buchberger([f1, f2], p, cmp)
  // generate a bunch of polynomials and check NF(f) = NF(f + q*generator)
  let mut seed = 7
  for k = 0; k < 20; k = k + 1 {
    seed = (seed * 1103515245 + 12345) % 1000003
    let a = seed % 5
    let b = seed / 5 % 5
    let c = seed / 25 % 5
    let d = seed / 125 % 5
    let f = poly_of([(a, [1, 0]), (b, [0, 1]), (c, [0, 0])], p)
    let j = poly_of([(d, [1, 0])], p) // multiplier
    let prod = @nf.poly_mul(j, f1, p, cmp)
    let fp = @nf.poly_add(f, prod, p, cmp)
    let nf1 = @nf.normal_form(f, g, p, cmp)
    let nf2 = @nf.normal_form(fp, g, p, cmp)
    assert_true(@nf.poly_eq(nf1, nf2))
    // and conversely: differing normal forms means f - fp ∉ I
    let diff = @nf.poly_sub(f, fp, p, cmp)
    if !@nf.poly_eq(nf1, nf2) {
      assert_false(@nf.in_ideal(diff, g, p, cmp))
    }
  }
}

///|
/// Ideal membership agrees with evaluation on the vanishing set for a
/// zero-dimensional radical example: I = (x^2 - x, y^2 - y) ⊂ F_2[x,y].
/// F_2[x,y]/I ≅ F_2 × F_2 × F_2 × F_2 (functions on {0,1}^2), so
/// f ∈ I iff f vanishes at all four points.
test "membership = vanishing on the variety (F_2, boolean ideal)" {
  let p = 2
  let cmp = grlex()
  let f1 = poly_of([(1, [2, 0]), (0 - 1, [1, 0])], p)
  let f2 = poly_of([(1, [0, 2]), (0 - 1, [0, 1])], p)
  let g = @nf.buchberger([f1, f2], p, cmp)
  assert_true(@nf.is_groebner(g, p, cmp))
  assert_eq(@nf.quotient_dim(g, 2, 4), 4)
  let pts = [(0, 0), (0, 1), (1, 0), (1, 1)]
  let mut seed = 3
  for k = 0; k < 30; k = k + 1 {
    seed = (seed * 1103515245 + 12345) % 1000003
    let c00 = seed % 2
    let c10 = seed / 2 % 2
    let c01 = seed / 4 % 2
    let c11 = seed / 8 % 2
    let c20 = seed / 16 % 2
    let f = poly_of(
      [
        (c00, [0, 0]),
        (c10, [1, 0]),
        (c01, [0, 1]),
        (c11, [1, 1]),
        (c20, [2, 0]),
      ],
      p,
    )
    let mut vanishes = true
    for (x, y) in pts {
      if eval_poly(f, x, y, p) != 0 {
        vanishes = false
      }
    }
    assert_eq(@nf.in_ideal(f, g, p, cmp), vanishes)
  }
}

///|
pub fn eval_poly(f : @nf.Poly, x : Int32, y : Int32, p : Int32) -> Int32 {
  let mut acc = 0
  for t in f {
    let mut v = t.c
    let mut i = 0
    while i < t.e[0] {
      v = v * x
      i = i + 1
    }
    i = 0
    while i < t.e[1] {
      v = v * y
      i = i + 1
    }
    acc = acc + v
  }
  @nf.mod_pos(acc, p)
}

///|
/// Initial ideals and the tropical membership test.
test "initial ideals and tropical membership" {
  let p = 101
  let cmp = grlex()
  // f = x + y + 1: its tropicalisation is the standard tropical line
  let f = poly_of([(1, [1, 0]), (1, [0, 1]), (1, [0, 0])], p)
  let g = @nf.buchberger([f], p, cmp)
  // w = (0,0): in_w(f) = f, not a monomial  => w IS in Trop(<f>)
  assert_true(@nf.is_tropical(g, [0, 0], p, cmp))
  // w = (1,0): in_w(f) = x, a monomial      => w is NOT in Trop(<f>)
  assert_false(@nf.is_tropical(g, [1, 0], p, cmp))
  // w = (0,1): in_w(f) = y, a monomial      => not tropical
  assert_false(@nf.is_tropical(g, [0, 1], p, cmp))
  // w = (1,1): in_w(f) = x + y              => tropical
  assert_true(@nf.is_tropical(g, [1, 1], p, cmp))
  // explicit initial forms
  let init = @nf.initial_form(f, [1, 0])
  assert_eq(init.length(), 1)
  assert_eq(@nf.mono_eq(init[0].e, [1, 0]), true)
}
